class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        // Code here
              int low = 0;
              int high = k - 1;
              int sum = 0;

              // Sum of first window (indices 0 to high, inclusive)
              for (int i = 0; i <= high; i++) {
                  sum = sum + arr[i];
              }

              int n = arr.length - 1;  // last valid index
              int res = sum;           // initialize res with first window's sum, OUTSIDE the loop

              while (high < n) {
                  low++;
                  high++;

                  sum = sum - arr[low - 1];  // remove element leaving window
                  sum = sum + arr[high];     // add element entering window

                  res = Math.max(res, sum);  // update max AFTER sliding
              }

              return res;
          
    }
}
